{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.aoe2-ai/dynamic-strategy.v1.schema.json",
  "title": "AOE2 Adjusted Dynamic Strategy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "civilization",
    "base_plan",
    "reactions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "civilization": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "base_plan": {
      "$ref": "#/$defs/basePlan"
    },
    "reactions": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/reaction"
      }
    }
  },
  "$defs": {
    "age": {
      "enum": [
        "dark",
        "feudal",
        "castle",
        "imperial"
      ]
    },
    "resourceMix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "food",
        "wood",
        "gold",
        "stone"
      ],
      "properties": {
        "food": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "wood": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "gold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "stone": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "scoutPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "land_explorers",
        "boat_explorers"
      ],
      "properties": {
        "land_explorers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "boat_explorers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "compositionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "role",
        "share_percent"
      ],
      "properties": {
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "role": {
          "enum": [
            "primary",
            "support"
          ]
        },
        "share_percent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "militaryPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "composition",
        "target_military_population"
      ],
      "properties": {
        "composition": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/compositionItem"
          }
        },
        "target_military_population": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        }
      }
    },
    "buildingTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "building",
        "target_count"
      ],
      "properties": {
        "building": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "target_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      }
    },
    "buildingPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "housing_headroom",
        "desired"
      ],
      "properties": {
        "housing_headroom": {
          "type": "integer",
          "minimum": 2,
          "maximum": 20
        },
        "desired": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/buildingTarget"
          }
        }
      }
    },
    "ageUpPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_civilian_population",
        "food_percent",
        "gold_percent"
      ],
      "properties": {
        "start_civilian_population": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "food_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "gold_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "marketSellRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource",
        "stock_above",
        "minimum_price"
      ],
      "properties": {
        "resource": {
          "enum": [
            "food",
            "wood",
            "stone"
          ]
        },
        "stock_above": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "minimum_price": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "marketBuyRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource",
        "stock_below",
        "gold_above",
        "maximum_price"
      ],
      "properties": {
        "resource": {
          "enum": [
            "food",
            "wood",
            "stone"
          ]
        },
        "stock_below": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "gold_above": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "maximum_price": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "marketPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gold_floor",
        "sell_rules",
        "buy_rules"
      ],
      "properties": {
        "gold_floor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "sell_rules": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/marketSellRule"
          }
        },
        "buy_rules": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/marketBuyRule"
          }
        }
      }
    },
    "militaryTech": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "technology",
        "beneficiary_units",
        "minimum_beneficiary_count"
      ],
      "properties": {
        "technology": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "beneficiary_units": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "minimum_beneficiary_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      }
    },
    "researchPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "economic_priority",
        "military"
      ],
      "properties": {
        "economic_priority": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "military": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/militaryTech"
          }
        }
      }
    },
    "threatPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enemy_units_in_town_trigger",
        "enemy_units_in_town_clear"
      ],
      "properties": {
        "enemy_units_in_town_trigger": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "enemy_units_in_town_clear": {
          "type": "integer",
          "minimum": 0,
          "maximum": 59
        }
      }
    },
    "combatPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attack_start_military_population",
        "attack_stop_military_population",
        "attack_group_size",
        "attack_soldier_percent"
      ],
      "properties": {
        "attack_start_military_population": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "attack_stop_military_population": {
          "type": "integer",
          "minimum": 0,
          "maximum": 199
        },
        "attack_group_size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "attack_soldier_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "targetPriority": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "active-attacker",
          "military-production",
          "town-center",
          "economy",
          "defensive-structure",
          "wonder",
          "closest"
        ]
      }
    },
    "basePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scouting",
        "economy",
        "military",
        "buildings",
        "age_up",
        "market",
        "research",
        "threat_response",
        "combat",
        "target_priority"
      ],
      "properties": {
        "scouting": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dark",
            "feudal",
            "castle",
            "imperial"
          ],
          "properties": {
            "dark": {
              "$ref": "#/$defs/scoutPlan"
            },
            "feudal": {
              "$ref": "#/$defs/scoutPlan"
            },
            "castle": {
              "$ref": "#/$defs/scoutPlan"
            },
            "imperial": {
              "$ref": "#/$defs/scoutPlan"
            }
          }
        },
        "economy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dark",
            "feudal",
            "castle",
            "imperial"
          ],
          "properties": {
            "dark": {
              "$ref": "#/$defs/resourceMix"
            },
            "feudal": {
              "$ref": "#/$defs/resourceMix"
            },
            "castle": {
              "$ref": "#/$defs/resourceMix"
            },
            "imperial": {
              "$ref": "#/$defs/resourceMix"
            }
          }
        },
        "military": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dark",
            "feudal",
            "castle",
            "imperial"
          ],
          "properties": {
            "dark": {
              "$ref": "#/$defs/militaryPlan"
            },
            "feudal": {
              "$ref": "#/$defs/militaryPlan"
            },
            "castle": {
              "$ref": "#/$defs/militaryPlan"
            },
            "imperial": {
              "$ref": "#/$defs/militaryPlan"
            }
          }
        },
        "buildings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dark",
            "feudal",
            "castle",
            "imperial"
          ],
          "properties": {
            "dark": {
              "$ref": "#/$defs/buildingPlan"
            },
            "feudal": {
              "$ref": "#/$defs/buildingPlan"
            },
            "castle": {
              "$ref": "#/$defs/buildingPlan"
            },
            "imperial": {
              "$ref": "#/$defs/buildingPlan"
            }
          }
        },
        "age_up": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "feudal",
            "castle",
            "imperial"
          ],
          "properties": {
            "feudal": {
              "$ref": "#/$defs/ageUpPlan"
            },
            "castle": {
              "$ref": "#/$defs/ageUpPlan"
            },
            "imperial": {
              "$ref": "#/$defs/ageUpPlan"
            }
          }
        },
        "market": {
          "$ref": "#/$defs/marketPlan"
        },
        "research": {
          "$ref": "#/$defs/researchPlan"
        },
        "threat_response": {
          "$ref": "#/$defs/threatPlan"
        },
        "combat": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dark",
            "feudal",
            "castle",
            "imperial"
          ],
          "properties": {
            "dark": {
              "$ref": "#/$defs/combatPlan"
            },
            "feudal": {
              "$ref": "#/$defs/combatPlan"
            },
            "castle": {
              "$ref": "#/$defs/combatPlan"
            },
            "imperial": {
              "$ref": "#/$defs/combatPlan"
            }
          }
        },
        "target_priority": {
          "$ref": "#/$defs/targetPriority"
        }
      }
    },
    "enemyUnitPressureTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "category",
        "minimum_count"
      ],
      "properties": {
        "type": {
          "const": "enemy_unit_pressure"
        },
        "category": {
          "enum": [
            "infantry",
            "spearman",
            "cavalry",
            "archer",
            "skirmisher",
            "cavalry-archer",
            "siege",
            "monk",
            "unique"
          ]
        },
        "minimum_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      }
    },
    "resourceShortageTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "resource",
        "stock_below"
      ],
      "properties": {
        "type": {
          "const": "resource_shortage"
        },
        "resource": {
          "enum": [
            "food",
            "wood",
            "gold",
            "stone"
          ]
        },
        "stock_below": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "underAttackTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "minimum_enemy_units_in_town"
      ],
      "properties": {
        "type": {
          "const": "under_attack"
        },
        "minimum_enemy_units_in_town": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "militaryDisadvantageTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "minimum_enemy_advantage"
      ],
      "properties": {
        "type": {
          "const": "military_disadvantage"
        },
        "minimum_enemy_advantage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "enemyFortificationTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "minimum_defensive_buildings"
      ],
      "properties": {
        "type": {
          "const": "enemy_fortification"
        },
        "minimum_defensive_buildings": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      }
    },
    "reactionMilitaryOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "composition",
        "target_military_population"
      ],
      "properties": {
        "composition": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/compositionItem"
          }
        },
        "target_military_population": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        }
      }
    },
    "reaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "priority",
        "ages",
        "when",
        "override"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "ages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/age"
          }
        },
        "when": {
          "oneOf": [
            {
              "$ref": "#/$defs/enemyUnitPressureTrigger"
            },
            {
              "$ref": "#/$defs/resourceShortageTrigger"
            },
            {
              "$ref": "#/$defs/underAttackTrigger"
            },
            {
              "$ref": "#/$defs/militaryDisadvantageTrigger"
            },
            {
              "$ref": "#/$defs/enemyFortificationTrigger"
            }
          ]
        },
        "override": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "scouting": {
              "$ref": "#/$defs/scoutPlan"
            },
            "economy": {
              "$ref": "#/$defs/resourceMix"
            },
            "military": {
              "$ref": "#/$defs/reactionMilitaryOverride"
            },
            "combat": {
              "$ref": "#/$defs/combatPlan"
            },
            "target_priority": {
              "$ref": "#/$defs/targetPriority"
            }
          }
        }
      }
    }
  }
}
