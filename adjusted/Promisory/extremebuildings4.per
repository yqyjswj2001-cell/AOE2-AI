(defrule
   (game-time < 60)
=>
   (set-goal temporary-goal8 8);max distance
   (set-goal temporary-goal9 3);max houses
)

(defrule
   (game-time > 60)
   (game-time < 180)
=>
   (set-goal temporary-goal8 12);max distance
   (set-goal temporary-goal9 5);max houses
)

(defrule
   (game-time > 300)
=>
   (set-goal temporary-goal8 16);max distance
   (set-goal temporary-goal9 6);max houses
)

(defrule
   (up-compare-goal increase-ts < 1)
   (game-time > 100)
   (up-pending-objects c: house < 3)
   (building-available house)
   (building-type-count-total house < 25)
   (game-time < 350)
=>
   (set-goal increase-ts house)
)

(defrule
   (up-compare-goal increase-ts < 1)
   (game-time > 120)
   (building-type-count-total siege-workshop < 1)
   (up-pending-objects c: siege-workshop < 1)
   (wood-amount > 500)
   (strategic-number sn-military-superiority > 0)
=>
   (set-goal increase-ts siege-workshop)
)

(defrule
   (up-compare-goal increase-ts < 1)
   (or(up-pending-objects c: house > 0)
   (game-time < 90))
   (up-pending-objects c: house > 1)
   (building-available stable)
   (building-type-count-total stable < 6)
   (game-time < 300)
=>
   (set-goal increase-ts stable)
)

(defrule
   (up-compare-goal increase-ts < 1)
   (or(up-pending-objects c: house > 0)
   (game-time < 90))
   (up-pending-objects c: house > 1)
   (building-available barracks)
   (building-type-count-total barracks < 6)
   (game-time < 300)
=>
   (set-goal increase-ts barracks)
)
(defrule
   (up-compare-goal increase-ts < 1)
   (or(up-pending-objects c: house > 0)
   (game-time < 90))
   (up-pending-objects c: house > 1)
   (building-available archery-range)
   (building-type-count-total archery-range < 6)
   (game-time < 300)
=>
   (set-goal increase-ts archery-range)
)



;Prefer selecting a villager that isn't building anything, otherwise prefer villagers with oldest command
(defrule
   (game-time < 350)
   (up-compare-goal increase-ts > 0)
   (or(up-can-build 0 g: increase-ts)
   (and(wood-amount > 500)
   (stone-amount > 700)))
   (up-get-fact temporary-goal4 unit-type-count villager-class)
   (up-modify-goal temporary-goal4 c:* 3);2
   (up-pending-objects c: building-class g:< temporary-goal4)
=>
   (up-full-reset-search)
   (up-set-target-point position-self-x)
   (up-filter-distance c: -1 g: temporary-goal8)
   (up-filter-exclude -1 orderid-build actionid-build -1)
   (up-find-local c: villager-class c: 40)
   ;(up-remove-objects search-local object-data-progress-value < 90)
   (set-goal temporary-goal 98342)
   (up-get-search-state local-total)
)

(defrule
   (goal temporary-goal 98342)
   (up-compare-goal local-total > 0)
   (up-set-target-object search-local c: 0)
=>
   (up-get-point position-object point-x)
   (up-cross-tiles point-x position-self-x c: 1)
   (up-bound-point point2-x point-x)
   (set-goal temporary-goal 98343)
   (set-goal temporary-goal3 6)
   (up-get-object-data object-data-id temporary-goal5)
   (set-goal local-total 0)
)

(defrule
   (goal temporary-goal 98343)
   ;(up-compare-goal local-total > 1)
   (up-set-target-object search-local c: 1)
=>
   (up-get-point position-object point3-x)
   (up-cross-tiles point3-x position-self-x c: -1)
   (set-goal temporary-goal6 97222)
)

(defrule
   (goal temporary-goal 98343)
   ;(up-compare-goal local-total > 2)
   (up-set-target-object search-local c: 2)
=>
   (up-get-point position-object point4-x)
   (up-cross-tiles point4-x position-self-x c: -1)
   (set-goal temporary-goal7 97333)
)

(defrule
   (goal temporary-goal 98343)
=>
   (up-full-reset-search)
   (up-set-target-point point-x)
   (up-filter-distance c: -1 c: 3)
   (up-filter-include -1 actionid-build -1 -1)
   (up-find-local c: villager-class c: 2)
   (up-remove-objects search-local object-data-id g:== temporary-goal5)
   (up-get-search-state local-total)
)

(defrule
   (goal temporary-goal 98343)
   (up-can-build-line point-x point-x g: increase-ts)
   (up-compare-goal local-total < 1)
=>
   (up-build-line point-x point-x g: increase-ts)
   (up-jump-rule 1)
)

(defrule
   (goal temporary-goal 98343)
   (up-compare-goal temporary-goal3 > 0)
=>
   (up-modify-goal temporary-goal3 c:- 1)
   (up-bound-point input-point-x point2-x)
   (set-goal point-variance 2)
   (xs-script-call "ApplyRandomnessToPoint")
   (up-bound-point point-x input-point-x)
   (up-jump-rule -3)
)

(defrule
   (goal temporary-goal6 97222)
   (building-type-count-total dm-building < 10)
=>
   (set-goal increase-ts dm-building)
   (up-bound-point point-x point3-x)
   (set-goal temporary-goal6 97221)
   (set-goal temporary-goal3 12)
   (up-jump-rule -4)
)
#load-if-not-defined HUN-CIV
#load-if-not-defined INCAN-CIV
(defrule
   (goal temporary-goal7 97333)
   (building-type-count-total house < 40)
   (or(housing-headroom < 35)
   (and(up-pending-objects c: castle > 0)
   (up-pending-objects c: house < 3)))
   (up-pending-objects c: house g:< temporary-goal9)
   (or(up-pending-objects c: stable > 1)
   (or(up-pending-objects c: barracks > 1)
   (up-pending-objects c: archery-range > 1)))
=>
   (set-goal increase-ts house)
   (up-bound-point point-x point4-x)
   (set-goal temporary-goal7 97332)
   (set-goal temporary-goal3 5)
   (up-jump-rule -5)
)

#end-if
#end-if

(defrule
   (game-time < 150)
=>
   (up-full-reset-search)
   (up-set-target-point position-self-x)
   (up-modify-goal temporary-goal8 c:+ 1)
   (up-filter-distance g: temporary-goal8 c: -1)
   (up-filter-status c: status-pending c: list-active)
   (up-find-status-local c: building-class c: 20)
   (up-remove-objects search-local object-data-hitpoints > 20)
   (up-modify-goal temporary-goal7 g:= sn-focus-player-number)
   (up-reset-filters)
   (up-find-remote c: villager-class c: 1)
   (up-target-objects 0 action-delete -1 -1)
   (up-modify-sn sn-focus-player-number g:= temporary-goal7)
   (disable-self)
 )

