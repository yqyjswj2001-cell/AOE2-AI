(defrule
   (game-time < 360)
=>
   (up-full-reset-search)
   (up-filter-status c: status-pending c: list-active)
   (up-find-status-local c: building-class c: 40)
   (up-remove-objects search-local object-data-tasks-count > 0)
)

(defrule
   (game-time < 360)
   (up-set-target-object search-local c: 0)
=>
   (up-get-point position-object point-x)
   (up-get-object-data object-data-id temporary-goal)
   (up-full-reset-search)
   (up-set-target-point point-x)
   ;(up-filter-exclude -1 actionid-build orderid-build -1)
   (up-filter-distance c: -1 c: 4)
   (up-find-local c: villager-class c: 1)
   (up-add-object-by-id search-remote g: temporary-goal)
   (set-goal temporary-goal2 83333)
)

(defrule
   (goal temporary-goal2 83333)
   (up-set-target-object search-local c: 0)
   (up-object-target-data object-data-hitpoints < 100)
=> 
   (up-target-objects 0 action-default -1 -1)
)

(defrule
   (players-military-population my-player-number < 3)
   (game-time < 180)
=>
   (up-full-reset-search)
   (up-find-local c: villager-class c: 7)
   (up-remove-objects search-local object-data-order != orderid-build)
   (up-remove-objects search-local object-data-action == actionid-move)
   (set-goal remote-total 0)
)


(defrule
   (game-time < 180)
   (up-set-target-object search-local c: 0)
   (up-compare-goal remote-total < 1)
=>
   (up-get-point position-object point-x)
   (up-set-target-point point-x)
   (up-filter-distance c: -1 c: 5)
   (up-modify-sn sn-focus-player-number s:= sn-target-player-number)
   (up-find-remote c: scout-cavalry-class c: 1)
   (up-find-remote c: knight-line c: 1)
   (up-find-remote c: eagle-warrior-line c: 1)
   (up-find-remote c: camel-line c: 1)
   (up-find-remote c: champi-line c: 1)
   (up-remove-objects search-local -1 == 0)
   ;(up-bound-point point2-x point-x)
   ;(up-lerp-tiles point2-x position-self-x c: -1)
   (up-get-object-target-data object-data-point-x point2-x)
   (up-get-object-target-data object-data-point-y point2-y)
   (up-get-search-state local-total)
   (set-goal temporary-goal8 73333)
   (up-jump-rule -1)
)

(defrule
   (goal temporary-goal8 73333)
   (up-compare-goal remote-total > 0)
   (up-pending-objects c: stone-wall < 6);3
   ;(up-point-contains point2-x == building-class)
   (up-point-distance point-x point2-x < 3)
=>
   (up-bound-point point2-x point-x)
   (up-bound-point point3-x point-x)
   (up-bound-point point4-x point-x)
   (up-bound-point point5-x point-x)
   ;(up-lerp-tiles point2-x position-self-x c: 1)
   ;(up-lerp-tiles point5-x position-self-x c: -1)
   ;(up-cross-tiles point3-x position-self-x c: 1)
   ;(up-cross-tiles point4-x position-self-x c: -1)
   (up-modify-goal point2-x c:+ 1)
   (up-modify-goal point4-x c:- 1)
   (up-modify-goal point3-y c:+ 1)
   (up-modify-goal point5-y c:- 1)
   (up-build-line point2-x point2-x c: stone-wall)
   (up-build-line point3-x point3-x c: stone-wall)
   (up-build-line point4-x point4-x c: stone-wall)
   (up-build-line point5-x point5-x c: stone-wall)
   (up-assign-builders c: stone-wall c: -1)
)

(defrule
   (up-pending-objects c: stone-wall > 0)
   (game-time < 180)
=>
   (up-full-reset-search)
   (up-get-point point4-x enemy-x)
   (up-set-target-point position-self-x)
   (up-filter-distance c: -1 c: 11)
   (up-filter-include 4 -1 -1 -1)
   (up-find-remote c: all-units-class c: 1)
)

(defrule
   (up-pending-objects c: stone-wall > 0)
   (game-time < 180)
   (up-set-target-object search-remote c: 0)
=>
   (up-get-point position-object point4-x)
)
(defrule
   (up-pending-objects c: stone-wall > 0)
   (game-time < 180)
=>
   (up-full-reset-search)
   (up-modify-goal temporary-goal7 s:= sn-focus-player-number)
   (set-strategic-number sn-focus-player-number my-player-number)
   (up-filter-status c: status-pending c: list-active)
   (up-find-status-remote c: stone-wall c: 5)
   (set-goal temporary-goal6 94211)
   (up-modify-sn sn-focus-player-number g:= temporary-goal7)  
)

(defrule
   (goal temporary-goal6 94211)
   (up-set-target-object search-remote c: 0)
=>
   (up-get-point position-object point2-x)
   (up-set-target-point point2-x)
   (up-remove-objects search-remote object-data-hitpoints > 50)
   (up-filter-distance c: -1 c: 2)
   (up-find-status-remote c: building-class c: 1)
   (up-remove-objects search-remote object-data-hitpoints > 125)
   (up-set-target-point point4-x)
   (up-clean-search search-remote object-data-distance search-order-asc)
   (up-remove-objects search-remote -1 > 0)
   (up-get-search-state local-total)
)

(defrule
   (goal temporary-goal6 94211)
   (up-set-target-object search-remote c: 0)
=>
   (up-get-point position-object point-x)
   (up-set-target-point point-x)
   (up-filter-distance c: -1 c: 3)
   (up-find-local c: villager-class c: 1)
   (up-target-objects 0 action-default -1 -1)
)

(defrule
   (or(game-time > 200)
   (or(and(game-time > 110)
   (and(building-type-count dm-building < 1)
   (building-type-count stable < 1)))
   (players-military-population my-player-number > 2)))
=>
   (up-full-reset-search)
   (up-find-remote c: -1 c: 1)
   (up-set-target-point position-self-x)
   (up-filter-distance c: -1 c: 12)
   (up-filter-status c: status-pending c: list-active)
   (up-find-status-local c: stone-wall c: 10)
   (up-reset-filters)
   (up-filter-distance c: -1 c: 12)
   (up-find-local c: stone-wall c: 10)
   (up-target-objects 0 action-delete -1 -1)
)
