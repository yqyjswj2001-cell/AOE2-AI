{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {"command": "python -X utf8 -B .cursor/hooks/aoe2-usage.py"}
    ],
    "beforeSubmitPrompt": [
      {"command": "python -X utf8 -B .cursor/hooks/aoe2-usage.py"}
    ],
    "afterAgentResponse": [
      {"command": "python -X utf8 -B .cursor/hooks/aoe2-usage.py"}
    ],
    "subagentStart": [
      {"command": "python -X utf8 -B .cursor/hooks/aoe2-usage.py"}
    ],
    "subagentStop": [
      {"command": "python -X utf8 -B .cursor/hooks/aoe2-usage.py"}
    ],
    "stop": [
      {"command": "python -X utf8 -B .cursor/hooks/aoe2-usage.py"}
    ],
    "sessionEnd": [
      {"command": "python -X utf8 -B .cursor/hooks/aoe2-usage.py"}
    ]
  }
}
